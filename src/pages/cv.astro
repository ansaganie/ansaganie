---
import BaseLayout from '../layouts/BaseLayout.astro';
import CvContent from '../components/cv/CvContent.astro';
import { getCandidateProfile } from '../utils/data';

const locale = 'en';
const profile = getCandidateProfile(locale);
---

<BaseLayout
  locale={locale}
  title={`${profile.name} — Curriculum Vitae & Career Timeline`}
  description="CV of Ansagan Islamgaliev, senior .NET and React engineer: 4+ years building enterprise software for Chevron and Tengizchevroil. PDF available."
>
  <CvContent profile={profile} locale={locale} />
</BaseLayout>
