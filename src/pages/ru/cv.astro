---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CvContent from '../../components/cv/CvContent.astro';
import { getCandidateProfile } from '../../utils/data';

const locale = 'ru';
const profile = getCandidateProfile(locale);
---

<BaseLayout
  locale={locale}
  title={`${profile.name} — Резюме и хронология карьеры`}
  description={`Резюме и хронология карьеры — ${profile.name}, ${profile.title}. Доступна ATS-совместимая PDF-версия.`}
>
  <CvContent profile={profile} locale={locale} />
</BaseLayout>
