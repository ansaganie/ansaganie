---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CvContent from '../../components/cv/CvContent.astro';
import { getCandidateProfile } from '../../utils/data';

const locale = 'ru';
const profile = getCandidateProfile(locale);
---

<BaseLayout
  locale={locale}
  title={`${profile.name} — Резюме и хронология карьеры`}
  description="Резюме Ансагана Исламгалиева, старшего .NET и React разработчика: 4+ года создания корпоративных систем для Chevron и Тенгизшевройл. Доступен PDF."
>
  <CvContent profile={profile} locale={locale} />
</BaseLayout>
