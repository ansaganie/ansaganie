---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CvContent from '../../components/cv/CvContent.astro';
import { getCandidateProfile } from '../../utils/data';

const locale = 'kk';
const profile = getCandidateProfile(locale);
---

<BaseLayout
  locale={locale}
  title={`${profile.name} — Өмірбаян және мансап жолы`}
  description="Аңсаған Исламғалиевтің өмірбаяны, аға .NET және React әзірлеушісі: Chevron және Теңізшевройл үшін корпоративтік жүйелер жасауда 4+ жыл тәжірибе. PDF нұсқасы қолжетімді."
>
  <CvContent profile={profile} locale={locale} />
</BaseLayout>
