---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;

const homePath = getLocalizedPath('/', locale);
const cvPath = getLocalizedPath('/cv', locale);

const isHome = currentPath === homePath || currentPath === `${homePath}/`;
const isCv = currentPath === cvPath || currentPath === `${cvPath}/`;
---

<header class="site-header no-print sm:sticky top-0 z-40 w-full border-b border-border-hairline bg-canvas/90 backdrop-blur-md transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-2 sm:py-0 sm:h-14 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <!-- Brand / Identity -->
    <a
      href={homePath}
      class="flex items-center gap-2 group text-content-primary font-semibold text-sm tracking-tight focus-visible:outline-2 focus-visible:outline-border-focus"
    >
      <span class="w-2.5 h-2.5 rounded-full bg-status-success motion-safe:animate-pulse" title={t('meta.availability')}></span>
      <span class="group-hover:text-brand transition-colors">{t('site.name')}</span>
    </a>

    <!-- Navigation & Controls -->
    <div class="flex flex-wrap items-center gap-x-2 gap-y-2 sm:gap-4">
      <nav class="flex items-center gap-1 sm:gap-2 text-xs font-medium" aria-label="Main Navigation">
        <a
          href={homePath}
          class:list={[
            'px-2.5 py-1 rounded transition-colors',
            isHome
              ? 'bg-surface-3 text-content-primary font-semibold'
              : 'text-content-secondary hover:text-content-primary hover:bg-surface-2',
          ]}
          aria-current={isHome ? 'page' : undefined}
        >
          {t('nav.overview')}
        </a>
        <a
          href={cvPath}
          class:list={[
            'px-2.5 py-1 rounded transition-colors',
            isCv
              ? 'bg-surface-3 text-content-primary font-semibold'
              : 'text-content-secondary hover:text-content-primary hover:bg-surface-2',
          ]}
          aria-current={isCv ? 'page' : undefined}
        >
          {t('nav.cv')}
        </a>
      </nav>

      <!-- Print Trigger Button -->
      <button
        type="button"
        id="print-btn"
        class="js-only hidden sm:inline-flex items-center gap-1.5 px-2 py-1 text-xs font-mono rounded border border-border-control bg-surface-2 text-content-secondary hover:text-content-primary hover:border-brand transition-colors focus-visible:outline-2 focus-visible:outline-border-focus"
        title={t('cta.print')}
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        <span>PDF</span>
      </button>

      <div class="hidden sm:block h-4 w-px bg-border-subtle" aria-hidden="true"></div>

      <!-- Language selector and theme toggle wrap together on narrow screens -->
      <div class="flex items-center gap-2 sm:gap-4">
        <LanguageSwitcher />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const printBtn = document.getElementById('print-btn');
  if (printBtn) {
    printBtn.addEventListener('click', () => {
      window.print();
    });
  }
</script>
