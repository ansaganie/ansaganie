---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { LOCALES, DEFAULT_LOCALE, getLocaleFromUrl, getLocalizedPath, useTranslations, type Locale } from '../utils/i18n';
import { getCandidateProfile } from '../utils/data';
import '../styles/global.css';
import '../styles/print.css';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const currentLocale = Astro.props.locale || getLocaleFromUrl(Astro.url);
const t = useTranslations(currentLocale);

const pageTitle = Astro.props.title || t('site.title');
const pageDescription = Astro.props.description || t('site.description');

// Identity comes from the CV data so metadata can't drift from the visible page.
// The Latin name is canonical on every locale (D4); jobTitle follows the page locale.
const profile = getCandidateProfile(currentLocale);
const canonical = getCandidateProfile(DEFAULT_LOCALE);
const [addressLocality, addressCountry] = canonical.contact.location.split(', ');

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://ansaganie.github.io';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

// Alternate hreflang links
const alternateUrls = LOCALES.map((loc) => ({
  locale: loc,
  href: new URL(getLocalizedPath(Astro.url.pathname, loc), siteUrl).toString(),
}));
const defaultHref = new URL(getLocalizedPath(Astro.url.pathname, DEFAULT_LOCALE), siteUrl).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: canonical.name,
      // Former and Cyrillic spellings (D4, D8)
      alternateName: [
        'Angsagan Islyamgaliyev',
        'Ansagan Islamgali',
        'Ансаган Исламгалиев',
        'Аңсаған Исламғалиев',
        'Аңсаған Ислямғалиев',
      ],
      description: profile.summary,
      jobTitle: profile.title,
      url: siteUrl,
      email: `mailto:${canonical.contact.email}`,
      telephone: canonical.contact.phone,
      sameAs: [canonical.contact.github, canonical.contact.linkedin, canonical.contact.telegram],
      knowsAbout: profile.skills.primary,
      address: {
        '@type': 'PostalAddress',
        addressLocality,
        addressCountry,
      },
      knowsLanguage: ['en', 'ru', 'kk'],
      alumniOf: [
        {
          '@type': 'EducationalOrganization',
          name: 'Satbayev University',
        },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: `${canonical.name} — Live CV`,
      publisher: {
        '@id': `${siteUrl}/#person`,
      },
      inLanguage: ['en', 'ru', 'kk'],
    },
    {
      '@type': 'ProfilePage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: pageTitle,
      isPartOf: {
        '@id': `${siteUrl}/#website`,
      },
      mainEntity: {
        '@id': `${siteUrl}/#person`,
      },
      dateModified: profile.updatedAt || '2026-10-10',
      inLanguage: currentLocale,
    },
  ],
};
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Metadata -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={canonical.name} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Multilingual Hreflang alternates -->
    {alternateUrls.map((item) => <link rel="alternate" hreflang={item.locale} href={item.href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultHref} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:locale" content={currentLocale === 'en' ? 'en_US' : currentLocale === 'ru' ? 'ru_RU' : 'kk_KZ'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <!-- Typography: Google Fonts with Mandatory cyrillic & cyrillic-ext Subsets -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap&subset=latin,cyrillic,cyrillic-ext"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Inline theme init to prevent a flash of the wrong theme. Sets exactly one of
         .dark / .light so the OS-preference fallback in global.css (:root:not(.light))
         only applies when scripts are off. Also marks .js for JS-only controls. -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        let storedTheme = null;
        try {
          storedTheme = localStorage.getItem('theme');
        } catch (e) {}
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = storedTheme === 'dark' || (storedTheme !== 'light' && prefersDark);
        root.classList.toggle('dark', isDark);
        root.classList.toggle('light', !isDark);
        root.classList.add('js');
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col bg-canvas text-content-primary">
    <a
      href="#main"
      class="no-print sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:rounded focus:bg-surface-1 focus:text-content-primary focus:border focus:border-border-focus focus:text-sm focus:font-medium"
    >
      {t('a11y.skipToContent')}
    </a>

    <!-- Header Navigation -->
    <Header />

    <!-- Main Content Area -->
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none w-full max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- WebKit <details> Print Expansion Hook -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        window.addEventListener('beforeprint', () => {
          document.querySelectorAll('details').forEach((el) => {
            if (!el.hasAttribute('open')) {
              el.setAttribute('open', '');
              el.dataset.wasClosed = 'true';
            }
          });
        });

        window.addEventListener('afterprint', () => {
          document.querySelectorAll('details[data-was-closed="true"]').forEach((el) => {
            el.removeAttribute('open');
            delete el.dataset.wasClosed;
          });
        });
      }
    </script>
  </body>
</html>
