---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { LOCALES, DEFAULT_LOCALE, getLocaleFromUrl, getLocalizedPath, useTranslations, type Locale } from '../utils/i18n';
import '../styles/global.css';
import '../styles/print.css';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const currentLocale = Astro.props.locale || getLocaleFromUrl(Astro.url);
const t = useTranslations(currentLocale);

const pageTitle = Astro.props.title || t('site.title');
const pageDescription = Astro.props.description || t('site.description');

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://ansaganie.github.io';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

// Alternate hreflang links
const alternateUrls = LOCALES.map((loc) => ({
  locale: loc,
  href: new URL(getLocalizedPath(Astro.url.pathname, loc), siteUrl).toString(),
}));
const defaultHref = new URL(getLocalizedPath(Astro.url.pathname, DEFAULT_LOCALE), siteUrl).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'Angsagan Islyamgaliyev',
      alternateName: 'Аңсаған Ислямғалиев',
      jobTitle: 'Senior Full-Stack .NET & React Engineer',
      url: siteUrl,
      email: 'mailto:ansaganie@hotmail.com',
      telephone: '+77001002400',
      sameAs: [
        'https://github.com/ansaganie',
        'https://linkedin.com/in/ansaganie',
        'https://t.me/ansaganie',
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Atyrau',
        addressCountry: 'Kazakhstan',
      },
      knowsLanguage: ['en', 'ru', 'kk'],
      alumniOf: [
        {
          '@type': 'EducationalOrganization',
          name: 'Satbayev University',
        },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Angsagan Islyamgaliyev Portfolio & Live CV',
      publisher: {
        '@id': `${siteUrl}/#person`,
      },
      inLanguage: ['en', 'ru', 'kk'],
    },
    {
      '@type': 'ProfilePage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: pageTitle,
      isPartOf: {
        '@id': `${siteUrl}/#website`,
      },
      about: {
        '@id': `${siteUrl}/#person`,
      },
      inLanguage: currentLocale,
    },
  ],
};
---

<!doctype html>
<html lang={currentLocale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Metadata -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Angsagan Islyamgaliyev" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Multilingual Hreflang alternates -->
    {alternateUrls.map((item) => <link rel="alternate" hreflang={item.locale} href={item.href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultHref} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="Angsagan Islyamgaliyev Live CV" />
    <meta property="og:locale" content={currentLocale === 'en' ? 'en_US' : currentLocale === 'ru' ? 'ru_RU' : 'kk_KZ'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <!-- Typography: Google Fonts with Mandatory cyrillic & cyrillic-ext Subsets -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap&subset=latin,cyrillic,cyrillic-ext"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Inline Dark Mode Init to prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        const storedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>

  <body itemscope itemtype="https://schema.org/Person" class="min-h-screen flex flex-col bg-canvas text-content-primary">
    <!-- Header Navigation -->
    <Header />

    <!-- Main Content Area -->
    <main role="main" class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- WebKit <details> Print Expansion Hook -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        window.addEventListener('beforeprint', () => {
          document.querySelectorAll('details').forEach((el) => {
            if (!el.hasAttribute('open')) {
              el.setAttribute('open', '');
              el.dataset.wasClosed = 'true';
            }
          });
        });

        window.addEventListener('afterprint', () => {
          document.querySelectorAll('details[data-was-closed="true"]').forEach((el) => {
            el.removeAttribute('open');
            delete el.dataset.wasClosed;
          });
        });
      }
    </script>
  </body>
</html>
